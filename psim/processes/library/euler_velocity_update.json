{
 "process_id": "lib.euler_velocity_update",
 "name": "Discrete Velocity Update (Euler)",
 "version": "1.0.0",
 "category": "Discrete Updates",
 "kind": "update",
 "mode": "per_object",
 "description": "Explicit discrete rule v(n+1) = v(n) + a(n)·Δt using the object's Linear acceleration property.",
 "script": "velocity = self.velocity + self.linear_acceleration * dt\n",
 "tests": [
  {
   "name": "one step",
   "objects": {
    "self": {
     "velocity": [
      1,
      0,
      0
     ],
     "linear_acceleration": [
      0,
      0,
      -10
     ]
    }
   },
   "dt": 0.1,
   "expect": {
    "velocity": [
     1,
     0,
     -1
    ]
   }
  }
 ]
}